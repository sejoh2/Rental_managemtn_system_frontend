# Copy to .env and fill in. Never commit .env.
# The backend address the web app talks to.
VITE_API_URL=http://localhost:8080

# The chat with Kodi's assistant on the home page: the customer
# agent's address (empty hides the chat), and the business WhatsApp
# number it answers, digits only, for "Continue on WhatsApp".
VITE_AGENT_URL=http://localhost:8090
VITE_AGENT_WHATSAPP=
